{
  "info": {
    "_postman_id": "d4a0c40b-f37c-4c8a-894e-15b3beae3cc8",
    "name": "CarHub API",
    "description": "Collection untuk API yang sudah tersedia. Gunakan hanya terhadap local/dev database. Login admin memakai cookie HttpOnly yang dikelola cookie jar Postman. Jalankan request berurutan; GET katalog mengisi carId dan POST pembuatan admin mengisi createdAdminId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public API",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('reports API health', function () {",
                  "  pm.expect(pm.response.json()).to.eql({ status: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List cars",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cars?page=1&pageSize=20"
            },
            "description": "Mengisi collection variable carId dengan ID mobil pertama jika katalog tidak kosong."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a paginated car list', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.pagination).to.include.all.keys('page', 'pageSize', 'totalItems', 'totalPages');",
                  "  if (body.data.length > 0) {",
                  "    pm.collectionVariables.set('carId', String(body.data[0].id));",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get car detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cars/{{carId}}"
            },
            "description": "Memakai ID pertama dari request List cars. Jika katalog kosong, respons 404 tetap diterima."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a car or a not-found response', function () {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data).to.have.property('id');",
                  "  } else {",
                  "    pm.expect(body.error.code).to.eql('NOT_FOUND');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create car submission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellerName\": \"Postman Tester\",\n  \"sellerPhone\": \"+6281234567890\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Avanza\",\n  \"year\": 2020,\n  \"transmission\": \"Automatic\",\n  \"mileage\": 25000,\n  \"expectedPrice\": 180000000,\n  \"imageUrl\": \"https://images.example.test/carhub-postman-test.jpg\",\n  \"description\": \"Submission uji dari Postman; hapus atau moderasi data ini setelah pengujian.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/submissions"
            },
            "description": "Request ini menambahkan data submission berstatus pending ke database. Gunakan hanya pada local/dev."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates a pending submission', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.status).to.eql('pending');",
                  "  pm.collectionVariables.set('submissionId', String(body.data.id));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin auth",
      "description": "Isi adminEmail dan adminPassword pada environment. Login menetapkan cookie HttpOnly; Postman menyimpannya pada cookie jar untuk host baseUrl.",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/login"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const admin = pm.response.json().data.admin;",
                  "  pm.expect(admin).to.have.property('id');",
                  "  pm.expect(admin).to.have.property('role');",
                  "  pm.expect(admin).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current admin session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/session"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns the authenticated admin session', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.admin).to.have.property('id');",
                  "  pm.expect(pm.response.json().data.admin).to.have.property('role');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin users (owner only)",
      "description": "Set newAdminEmail dan newAdminPassword pada environment. Buat akun sebelum menonaktifkannya agar createdAdminId terisi.",
      "item": [
        {
          "name": "Create admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newAdminEmail}}\",\n  \"password\": \"{{newAdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates an admin account', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const admin = pm.response.json().data.admin;",
                  "  pm.expect(admin.role).to.eql('admin');",
                  "  pm.expect(admin.isActive).to.eql(true);",
                  "  pm.expect(admin).not.to.have.property('passwordHash');",
                  "  pm.collectionVariables.set('createdAdminId', String(admin.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate created admin",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{createdAdminId}}/deactivate"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deactivates the created admin', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const admin = pm.response.json().data.admin;",
                  "  pm.expect(admin.role).to.eql('admin');",
                  "  pm.expect(admin.isActive).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
    ,
    {
      "name": "Admin logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/auth/logout"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin logout clears the session', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:5173",
      "type": "string"
    },
    {
      "key": "carId",
      "value": "",
      "type": "string"
    },
    {
      "key": "submissionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdAdminId",
      "value": "",
      "type": "string"
    }
  ]
}
