{
  "info": {
    "_postman_id": "d4a0c40b-f37c-4c8a-894e-15b3beae3cc8",
    "name": "CarHub API",
    "description": "Collection API CarHub untuk local/development. Login admin memakai cookie HttpOnly yang dikelola cookie jar Postman. Jalankan request berurutan; submission publik mengisi submissionId untuk diuji approval admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public API",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{apiHost}}:{{apiPort}}/api/health",
              "protocol": "http",
              "host": ["{{apiHost}}"],
              "port": "{{apiPort}}",
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('reports API health', function () {",
                  "  pm.expect(pm.response.json()).to.eql({ status: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List cars",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{apiHost}}:{{apiPort}}/api/cars?page=1&pageSize=20",
              "protocol": "http",
              "host": ["{{apiHost}}"],
              "port": "{{apiPort}}",
              "path": ["api", "cars"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          },
          "description": "Mengisi collection variable carId dengan ID mobil pertama jika katalog tidak kosong.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a paginated car list', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.pagination).to.include.all.keys('page', 'pageSize', 'totalItems', 'totalPages');",
                  "  if (body.data.length > 0) {",
                  "    pm.collectionVariables.set('carId', String(body.data[0].id));",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get car detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{apiHost}}:{{apiPort}}/api/cars/{{carId}}",
              "protocol": "http",
              "host": ["{{apiHost}}"],
              "port": "{{apiPort}}",
              "path": ["api", "cars", "{{carId}}"]
            }
          },
          "description": "Memakai ID pertama dari request List cars. Jika katalog kosong, respons 404 tetap diterima.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a car or a not-found response', function () {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data).to.have.property('id');",
                  "  } else {",
                  "    pm.expect(body.error.code).to.eql('NOT_FOUND');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create car submission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellerName\": \"Postman Tester\",\n  \"sellerPhone\": \"+6281234567890\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Avanza\",\n  \"year\": 2020,\n  \"transmission\": \"Automatic\",\n  \"mileage\": 25000,\n  \"expectedPrice\": 180000000,\n  \"location\": \"Jakarta\",\n  \"imageUrl\": \"https://images.example.test/carhub-postman-test.jpg\",\n  \"description\": \"Submission uji dari Postman; hapus atau moderasi data ini setelah pengujian.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://{{apiHost}}:{{apiPort}}/api/submissions",
              "protocol": "http",
              "host": ["{{apiHost}}"],
              "port": "{{apiPort}}",
              "path": ["api", "submissions"]
            },
            "description": "Request ini menambahkan data submission berstatus pending ke database. Gunakan hanya pada local/dev."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates a pending submission', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.status).to.eql('pending');",
                  "  pm.collectionVariables.set('submissionId', String(body.data.id));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin auth",
      "description": "Isi adminEmail dan adminPassword pada environment. Login menetapkan cookie HttpOnly; Postman menyimpannya pada cookie jar untuk host API.",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://{{apiHost}}:{{apiPort}}/api/admin/auth/login",
              "protocol": "http",
              "host": ["{{apiHost}}"],
              "port": "{{apiPort}}",
              "path": ["api", "admin", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const admin = pm.response.json().data.admin;",
                  "  pm.expect(admin).to.have.property('id');",
                  "  pm.expect(admin).to.have.property('role');",
                  "  pm.expect(admin).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current admin session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{apiHost}}:{{apiPort}}/api/admin/auth/session",
              "protocol": "http",
              "host": ["{{apiHost}}"],
              "port": "{{apiPort}}",
              "path": ["api", "admin", "auth", "session"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns the authenticated admin session', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.admin).to.have.property('id');",
                  "  pm.expect(pm.response.json().data.admin).to.have.property('role');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin users (owner only)",
      "description": "Set newAdminEmail dan newAdminPassword pada environment. Buat akun sebelum menonaktifkannya agar createdAdminId terisi.",
      "item": [
        {
          "name": "Create admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newAdminEmail}}\",\n  \"password\": \"{{newAdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://{{apiHost}}:{{apiPort}}/api/admin/users",
              "protocol": "http",
              "host": ["{{apiHost}}"],
              "port": "{{apiPort}}",
              "path": ["api", "admin", "users"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates an admin account', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const admin = pm.response.json().data.admin;",
                  "  pm.expect(admin.role).to.eql('admin');",
                  "  pm.expect(admin.isActive).to.eql(true);",
                  "  pm.expect(admin).not.to.have.property('passwordHash');",
                  "  pm.collectionVariables.set('createdAdminId', String(admin.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate created admin",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": {
              "raw": "http://{{apiHost}}:{{apiPort}}/api/admin/users/{{createdAdminId}}/deactivate",
              "protocol": "http",
              "host": ["{{apiHost}}"],
              "port": "{{apiPort}}",
              "path": ["api", "admin", "users", "{{createdAdminId}}", "deactivate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deactivates the created admin', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const admin = pm.response.json().data.admin;",
                  "  pm.expect(admin.role).to.eql('admin');",
                  "  pm.expect(admin.isActive).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin submissions",
      "description": "Login admin terlebih dahulu. Buat submission lewat Public API agar submissionId terisi, lalu gunakan approval satu kali.",
      "item": [
        {
          "name": "List pending submissions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{apiHost}}:{{apiPort}}/api/admin/submissions?status=pending&page=1&pageSize=20",
              "protocol": "http",
              "host": ["{{apiHost}}"],
              "port": "{{apiPort}}",
              "path": ["api", "admin", "submissions"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a paginated pending submission list', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.pagination).to.include.all.keys('page', 'pageSize', 'totalItems', 'totalPages');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve submission",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"location\": \"Jakarta\",\n  \"imageUrl\": \"https://images.example.test/carhub-postman-test.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://{{apiHost}}:{{apiPort}}/api/admin/submissions/{{submissionId}}/status",
              "protocol": "http",
              "host": ["{{apiHost}}"],
              "port": "{{apiPort}}",
              "path": ["api", "admin", "submissions", "{{submissionId}}", "status"]
            },
            "description": "Mengubah submission pending menjadi approved dan membuat mobil katalog. Jalankan hanya sekali untuk submissionId yang dipilih."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('approves the submission and creates a catalog car', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.submission.status).to.eql('approved');",
                  "  pm.expect(body.data.car).to.have.property('id');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": {
          "raw": "http://{{apiHost}}:{{apiPort}}/api/admin/auth/logout",
          "protocol": "http",
          "host": ["{{apiHost}}"],
          "port": "{{apiPort}}",
          "path": ["api", "admin", "auth", "logout"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin logout clears the session', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ],
